    "clsx": "^2.1.1",
    "lucene": "^2.1.1",
    "maplibre-gl": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
